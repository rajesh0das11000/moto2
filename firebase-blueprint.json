{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Service": {
      "title": "Service Offered",
      "description": "Details of a wash or repair service.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string", "enum": ["car_wash", "bike_wash", "bike_repair"] },
        "duration": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "name", "price", "category"]
    },
    "Booking": {
      "title": "Service Booking",
      "description": "A booking for a specific service at a specific time.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "serviceId", "date", "time", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles restricted to the owner."
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Public catalog of services."
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Bookings managed by users and viewed by admins."
    }
  }
}
